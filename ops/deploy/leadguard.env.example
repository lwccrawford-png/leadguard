# Per-client env file for the systemd template unit. One copy per client at
# /etc/leadguard/<client_id>.env — e.g. /etc/leadguard/lmtlss.env
#
# The shared secrets (ANTHROPIC_API_KEY, PRODUCT_NAME, AGENCY_NOTIFY_*) still live in
# backend/.env on the server and are loaded by the app itself; this file only carries
# what's unique per running instance.

PORT=8001
LEADGUARD_DATA_DIR=/opt/leadguard/data/CLIENT_ID
