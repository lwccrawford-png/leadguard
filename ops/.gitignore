backend/venv/
backend/.env
backend/data*/*.db
backend/data*/*.pkl
__pycache__/
*.pyc

# Real client names, ports, and internal URLs — CLIENT_DIRECTORY.md's own header warns
# never to publish it anywhere, and clients.json names real clients/prospects. Keep both
# local-only even in a private repo.
ops/CLIENT_DIRECTORY.md
ops/clients.json
ops/outreach.db
ops/outreach_prospects_export.json

# Login credentials and session-signing secret for launcher_server.py's auth —
# never commit real passwords or the signing key, even in a private repo.
ops/auth_users.json
ops/.auth_secret
