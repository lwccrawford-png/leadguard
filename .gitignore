backend/venv/
backend/.env
backend/data*/*.db
backend/data*/*.pkl
__pycache__/
*.pyc

# Real client names, ports, and internal URLs — CLIENT_DIRECTORY.md's own header warns
# never to publish it anywhere, and clients.json names real clients/prospects. Keep both
# local-only even in a private repo.
ops/CLIENT_DIRECTORY.md
ops/clients.json
ops/outreach.db
ops/outreach_prospects_export.json

# Login credentials and session-signing secret for launcher_server.py's auth —
# never commit real passwords or the signing key, even in a private repo.
ops/auth_users.json
ops/.auth_secret

# Per-prospect sales demo pages generated by ops/generate_site_demo.py —
# created, regenerated, and retired constantly as part of the sales/demo
# lifecycle; tracking them means every demo event dirties the working tree.
backend/data_prospect_*/demo.html
widget/prospect_*.html
widget/*demo*.html

# tidycal_poller.py's own runtime bookkeeping (which bookings it's already
# alerted on) — regenerated on every server, not source.
ops/tidycal_poller_state.json
