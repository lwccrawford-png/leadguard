# Anthropic (required) — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-5

# Product/agency name shown in the dashboard and support page. Change this one value to
# rebrand — no code changes needed. Defaults to "LeadGuard" if unset.
PRODUCT_NAME=LeadGuard

# Comma-separated list of origins allowed to embed the widget, or "*" for any (fine for MVP/demo)
WIDGET_ALLOWED_ORIGINS=*

# Your own (agency) contact info for the /support page every client instance gets —
# same across every deployment, not per-client. A Slack Incoming Webhook works directly;
# a Zapier/Make catch-hook can fan out to email/SMS the same way the client-facing
# handoff webhook does.
AGENCY_NOTIFY_WEBHOOK_URL=
AGENCY_NOTIFY_EMAIL=
