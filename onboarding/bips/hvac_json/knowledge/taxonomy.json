  },
  "classification_rules": [
    {
      "if": ["gas_smell", "carbon_monoxide_concern", "smoke", "electrical_burning"],
      "then": "critical_safety",
      "action": "stop_troubleshooting_and_escalate"
    },
    {
      "if": ["no_heat", "freezing_weather"],
      "then": "emergency",
      "action": "same_day_or_after_hours_dispatch"
    },
    {
      "if": ["no_cooling", "dangerous_heat"],
      "then": "emergency",
      "action": "same_day_or_after_hours_dispatch"
    },
    {
      "if": ["system_age_over_12_years", "major_repair", "frequent_breakdowns"],
      "then": "replacement_opportunity",
      "action": "offer_comfort_advisor_consult"
    },
    {
      "if": ["not_member", "maintenance_request"],
      "then": "membership_opportunity",
      "action": "explain_plan_and_offer_enrollment"
    }
  ]
}

